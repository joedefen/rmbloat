#!/bin/bash
# Lint the package with pylint.
#
# Ruff is the primary linter; pylint is kept for errors that ruff does not model
# (for example a duplicate method definition).  Usage:
#
#     ./linter                 # lint ./rmbloat
#     ./linter rmbloat tests   # lint explicit paths
#
# `python -m pylint` is preferred (so the interpreter that owns rmbloat's
# dependencies is used); a `pylint` executable on PATH is the fallback.  Set
# PYTHON to pick a specific interpreter.  The sibling console_window checkout
# used to be added to sys.path unconditionally, which broke the script whenever
# that checkout was absent (and the dependency is declared in pyproject.toml
# anyway).  It is now used only when it actually exists, and every argument is
# forwarded instead of just `$1`.
set -u
PYTHON_BIN="${PYTHON:-python3}"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
PROJECT_A_PATH="$SCRIPT_DIR/../console_window"

[ "$#" -eq 0 ] && set -- rmbloat

if "$PYTHON_BIN" -c 'import pylint' >/dev/null 2>&1; then
    PYLINT_CMD=("$PYTHON_BIN" -m pylint)
else
    PYLINT_CMD=(pylint)
fi

if [ -d "$PROJECT_A_PATH" ]; then
    "${PYLINT_CMD[@]}" --init-hook="import sys; sys.path.insert(0, '$PROJECT_A_PATH')" "$@"
else
    "${PYLINT_CMD[@]}" "$@"
fi
